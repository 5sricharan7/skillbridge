# SkillBridge frontend configuration.
#
# Copy to `.env.local` (git-ignored) and edit. Never commit a real `.env`.
# Every variable is optional; the defaults below are the values used when unset.

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# 'api'  -> read roadmap, velocity and proof records from the FastAPI service
# 'mock' -> read the checked-in mock data, issuing no network requests
# Anything other than 'mock' is treated as 'api'.
VITE_CAREER_BRIDGE_MODE=api

# ---------------------------------------------------------------------------
# Backend base URL
# ---------------------------------------------------------------------------
# Leave empty to call same-origin paths. The dev server proxies the SkillBridge
# routes to this target (see vite.config.js), so an empty value works in `npm run
# dev`. Set it to an absolute URL when the service is hosted elsewhere, which is
# what a production build needs.
#
# Do not include a trailing slash. The backend enables CORS for
# http://localhost:5173 and http://127.0.0.1:5173 by default; override with the
# SKILLBRIDGE_CORS_ORIGINS environment variable when serving from another origin.
VITE_CAREER_BRIDGE_API=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Target role
# ---------------------------------------------------------------------------
# Artifact role category sent as `target_role` on POST /roadmap. It selects which
# backend role priors and prerequisites enrich the plan; the job description text
# is what actually drives the signals.
#
# The backend currently plans these categories:
#   data_science, backend_ml_engineer, other
#
# The product's own target role, 'Embedded Systems Engineer', is not one of them.
# Left unset, the app requests that role and reports honestly that no live roadmap
# is available for it. Set a supported category to plan against the live service:
VITE_CAREER_BRIDGE_TARGET_ROLE=data_science
